{
  "name": "ai-driven-gift-recommender",
  "version": "0.0.0",
  "description": "GiftAI pairs a cinematic landing page with AI-powered gift recommendations.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "homepage": "https://OMKAR580.github.io/AI-Driven-Gift-Recommender",
  "scripts": {
    "api": "node server.js",
    "dev:vite": "vite --configLoader native",
    "dev": "concurrently -k -n api,vite -c cyan,magenta \"node server.js\" \"npm run dev:vite\"",
    "build": "vite build --configLoader native",
    "preview": "vite preview --configLoader native",
    "start": "npm run dev",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "gh-pages": "^6.3.0",
    "vite": "^8.0.4"
  },
  "dependencies": {
    "axios": "^1.15.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "firebase": "^12.12.0",
    "gsap": "^3.14.2",
    "node-cache": "^5.1.2"
  }
}
